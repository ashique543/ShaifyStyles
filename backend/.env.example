# =================================================================
# SHAIFY STYLES E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to backend/.env and update with your live credentials
# =================================================================

# Server & Security
FLASK_ENV=development
PORT=5000
SECRET_KEY=shaify_styles_boutique_secret_key_2025
JWT_SECRET_KEY=shaify_admin_jwt_super_secret_2025_change_in_prod
JWT_ACCESS_TOKEN_EXPIRES_HOURS=720

# Database (PostgreSQL for production; defaults to SQLite for local development)
DATABASE_URL=sqlite:///shaifystyles.db
# Production example:
# DATABASE_URL=postgresql://user:password@ep-lucky-pool.neon.tech/shaifystyles?sslmode=require

# Razorpay Payment Gateway (Test or Live API Keys)
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret

# Customer Authentication: Google Sign-In OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Customer Authentication: Mobile Phone SMS OTP
SMS_GATEWAY=simulation # Options: 'simulation' (logs to console & screen), 'fast2sms', 'twilio'
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRY_MINUTES=10
DEMO_OTP=123456

# Media & Image Storage (Cloudinary CDN or Local Server Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brand Contact & WhatsApp Integration
WHATSAPP_PHONE=919876543210
BRAND_INSTAGRAM=@shaifystyles_
